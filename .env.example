# Example environment variables for PriceLance
# Replace placeholders with real values in your deployment. DO NOT commit real secrets.

#########################
# REQUIRED - Application Core
#########################
# Buyer-owned PostgreSQL / Supabase connection string.
# Use a production-grade managed database for the deployment environment.
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB"

# Server-side admin token for admin API routes via x-admin-token
# Used by /api/admin/* routes and middleware for protected endpoints.
ADMIN_TOKEN=REPLACE_ADMIN_TOKEN

# Server-side internal API key for internal APIs via x-internal-key
# Protects /api/internal/* endpoints from unauthorized access.
INTERNAL_API_KEY=REPLACE_INTERNAL_API_KEY

#########################
# REQUIRED - Production Admin Access
#########################
# HTTP Basic Auth username for /admin and /api/admin routes in production.
# Used by middleware.ts and proxy.ts for protected admin area.
ADMIN_USER=admin

# HTTP Basic Auth password for /admin and /api/admin routes in production.
# Must be set in production; in development, admin routes are accessible without auth.
ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD

#########################
# OPTIONAL - Deployment Metadata
#########################
# Public application base URL (recommended for production deployments).
# Used for constructing absolute URLs in emails and analytics.
# Falls back to http://localhost:3000 if not set.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# GitHub repository URL (for public reference only).
NEXT_PUBLIC_GITHUB_URL=

#########################
# OPTIONAL - Contact & Email Delivery
#########################
# Enable contact form email delivery. If false, contact submissions are logged but not sent.
ENABLE_CONTACT_EMAIL=false

# Recipient email address for contact form submissions.
# Falls back to NEXT_PUBLIC_CONTACT_EMAIL if not set.
CONTACT_EMAIL=

# Public contact email address displayed on the website (does not need to be secret).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Resend.com API key for email delivery (preferred method).
# If set, Resend will be used; otherwise Nodemailer SMTP fallback is attempted.
RESEND_API_KEY=

# Sender email address for Resend (recommended: use a verified sender).
# Falls back to no-reply@pricelance.com if not set.
RESEND_FROM=

# SMTP fallback for email delivery (Nodemailer).
# Only used if Resend is not configured or fails.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

#########################
# OPTIONAL - User Location & Geolocation
#########################
# Geolocation API URL and key for "Use my location" feature.
# If not set, location detection will return an error and users can still use the app without location.
GEO_COUNTRY_API_URL=
GEO_COUNTRY_API_KEY=

#########################
# OPTIONAL - Queue & Background Jobs
#########################
# Redis connection URL for BullMQ queue (job ingestion, scheduling).
# If not set, Redis connection is attempted via REDIS_HOST/REDIS_PORT/REDIS_PASSWORD.
# If neither is available, background jobs will fail with a clear error message.
REDIS_URL=

# Alternative to REDIS_URL: individual Redis connection parameters.
# Used only if REDIS_URL is not set.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

#########################
# OPTIONAL - Scheduled Ingestion
#########################
# Scheduled ingestion mode: "manual", "hourly", or "daily".
# Default: "daily"
SCHEDULED_INGESTION_MODE=daily

# JSON array of scheduled URL feed imports.
# Example: [{"id":"feed1","name":"Feed 1","url":"https://...","schedule":"daily"}]
SCHEDULED_URL_FEEDS=

# JSON array of scheduled affiliate feed imports.
# Example: [{"id":"aff1","name":"Aff 1","provider":"banggood","categoryId":"1011","schedule":"hourly"}]
SCHEDULED_AFFILIATE_FEEDS=

# Hours after which a merchant feed run is considered stale.
# Default: 48
SCHEDULED_STALE_FEED_THRESHOLD_HOURS=48

#########################
# OPTIONAL - Advertising & Analytics
#########################
# Enable display of ads on the site.
NEXT_PUBLIC_ADS_ENABLED=false

# Google AdSense client ID (required for ads to display).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google AdSense slot IDs for different page sections.
# Use these environment variables to configure ad placements without code changes.
NEXT_PUBLIC_ADSENSE_HEADER_SLOT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS_INLINE=

# Google Analytics measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google site verification tag (for Search Console).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Profitshare affiliate program ID (for metadata only).
NEXT_PUBLIC_PROFITSHARE_ID=

# Skimlinks script source (if using Skimlinks for affiliate link management).
NEXT_PUBLIC_SKIMLINKS_SCRIPT_SRC=

#########################
# OPTIONAL - Internal Ingestion API
#########################
# Enable the internal ingestion endpoint (/api/internal/ingest).
# If false, the endpoint returns 404 Not Found.
ALLOW_INTERNAL_INGEST=false

#########################
# DORMANT / DISABLED - Optional Integrations (Not Active)
#########################
# The following integrations are implemented but not active by default.
# Enable them only if you intend to use them and have obtained credentials.

# Real-Time Product Search (RapidAPI aggregator) - disabled by default.
# Set PROVIDER_REALSTORE_ENABLED=true to enable.
PROVIDER_REALSTORE_ENABLED=false
REALTIME_PRODUCT_SEARCH_BASE_URL=https://real-time-product-search.p.rapidapi.com
REALTIME_PRODUCT_SEARCH_API_KEY=

# eBay integration (sandbox and production) - disabled by default.
# eBay feed is not active in current buyer configuration.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CLIENT_ID_PROD=
EBAY_CLIENT_SECRET_PROD=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DEFAULT_LIMIT=20

# Banggood affiliate integration - disabled by default.
# Set PROVIDER_BANGGOOD_ENABLED=true to enable.
BANGGOOD_APP_KEY=
BANGGOOD_APP_SECRET=

# Affiliate import feature - disabled by default.
# Set ENABLE_AFFILIATE_IMPORT=true to enable affiliate CSV imports via /api/admin/import-*.
ENABLE_AFFILIATE_IMPORT=false
IMPORT_SECRET=

#########################
# NOTES
#########################
# - Keep all secrets out of source control; copy this file to `.env.local` and fill values locally.
# - The current owner's live database and credentials are not the permanent buyer handoff. 
#   Configure a buyer-owned PostgreSQL/Supabase environment and set DATABASE_URL for that deployment.
# - Server-side secrets such as ADMIN_TOKEN, ADMIN_PASSWORD, INTERNAL_API_KEY, and RESEND_API_KEY
#   must NOT be exposed via NEXT_PUBLIC_* variables.
# - Set ADMIN_USER and ADMIN_PASSWORD in production to protect /admin routes with HTTP Basic Auth.
# - Email delivery gracefully degrades if not configured; users can still submit contact forms.